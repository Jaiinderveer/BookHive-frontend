# BookHive frontend - example environment file.
#
# Copy this to `.env` (git-ignored) and fill in the values locally.
# Variable NAMES only: never commit actual usernames, passwords or keys.

# Librarian account used by the E2E smoke test (`node e2e-smoke.mjs`).
# Required - the script exits if either is unset and has no fallback account.
# Not prefixed with VITE_, so Vite never inlines these into the browser bundle.
E2E_LIBRARIAN_USERNAME=
E2E_LIBRARIAN_PASSWORD=
